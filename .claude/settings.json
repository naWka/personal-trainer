{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python3 *)",
      "Bash(python3)",
      "Bash(cd /Users/nawka/Documents/GitHub/personal-trainer*)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rmdir *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(open *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(sleep *)",
      "Bash(for *)",
      "Bash(if *)",
      "Bash(test *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard origin*)",
      "Bash(gh auth token*)",
      "Bash(gh auth logout*)",
      "Bash(gh repo delete*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.zshrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/sync.sh\"",
            "timeout": 60,
            "statusMessage": "Синхронизация данных с origin/main"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/gym.py\" resume",
            "timeout": 15,
            "statusMessage": "Проверка незакрытой тренировки"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/gym.py\" hook",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/facts.py\"",
            "timeout": 30,
            "statusMessage": "Числа из файлов"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/plancheck.py\" stop",
            "timeout": 600,
            "statusMessage": "План читают профильные тренеры"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/autopush.sh\"",
            "timeout": 90,
            "statusMessage": "Автопуш в main"
          }
        ]
      }
    ]
  }
}